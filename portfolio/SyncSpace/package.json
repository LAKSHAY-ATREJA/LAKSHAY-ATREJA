{
  "name": "syncspace",
  "version": "1.0.0",
  "private": true,
  "author": "Lakshay Atreja",
  "scripts": {
    "server": "node --import tsx server/index.ts",
    "client": "vite --host 0.0.0.0 client",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.server.json && vite build client --outDir ../dist --emptyOutDir",
    "start": "node build/server/index.js",
    "demo": "node --import tsx demo.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
